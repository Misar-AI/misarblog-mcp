{
  "mcpServers": {
    "misarblog": {
      "command": "npx",
      "args": [
        "-y",
        "@misarblog/mcp@latest"
      ],
      "env": {
        "MISARBLOG_API_KEY": "mbk_YOUR_KEY_HERE"
      }
    },
    "misarblog-remote": {
      "url": "https://www.misar.blog/api/mcp",
      "headers": {
        "Authorization": "Bearer mbk_YOUR_KEY_HERE"
      }
    }
  }
}
